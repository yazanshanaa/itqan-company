{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/img/**", "use": "@vercel/static" },
    { "src": "public/fonts/**", "use": "@vercel/static" },
    { "src": "public/favicon.ico", "use": "@vercel/static" },
    { "src": "public/apple-touch-icon.png", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/img/orginal\\.png",
      "status": 301,
      "headers": { "Location": "/img/logo.png" }
    },
    {
      "src": "/fonts/(.+)",
      "dest": "/public/fonts/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/img/(.+)",
      "dest": "/public/img/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/(favicon\\.ico|apple-touch-icon\\.png)",
      "dest": "/public/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      }
    },
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "env": { "NODE_ENV": "production" }
}
